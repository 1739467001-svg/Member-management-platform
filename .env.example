# ── HHStudio Junye 会员管理系统 环境变量 ──
# 复制为 .env 后修改

# 【必填】Postgres 连接串
# Vercel：在 Storage 里创建数据库后会自动注入，无需手填
# 本地/自托管：指向你自己的 Postgres
DATABASE_URL=postgres://hh:hh@localhost:5432/hhstudio

# 【必填】会话签名密钥，生成方式：openssl rand -hex 32
AUTH_SECRET=please-change-me-to-a-random-32-byte-hex-string

# 初始登录密码（首次建库时写入，之后可在设置页修改）
INITIAL_PASSWORD=0000

# 每日任务的调用令牌。Vercel Cron 会自动带上 CRON_SECRET
CRON_SECRET=please-change-me-too

# 业务时区。Vercel 默认 UTC，不设的话「今天」会算错，务必设置
TZ=Asia/Shanghai

# 会话 Cookie 的 Secure 标记，默认按请求协议自动判断，一般不用设
# COOKIE_SECURE=true
