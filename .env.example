# ── HHStudio Junye 会员管理系统 环境变量 ──
# 复制为 .env 后修改

# 会话签名密钥：必须修改！生成方式 openssl rand -hex 32
AUTH_SECRET=please-change-me-to-a-random-32-byte-hex-string

# 初始登录密码（首次启动时写入数据库，之后可在设置页修改）
INITIAL_PASSWORD=hhstudio2026

# SQLite 数据库文件路径
DATABASE_PATH=./data/app.db

# 每日定时任务的调用令牌（供服务器 crontab 兜底调用）
CRON_TOKEN=please-change-me-too

# 时区
TZ=Asia/Shanghai
